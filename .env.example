# ── Backend: "anthropic", "ollama", or "offline" ──
BACKEND=anthropic

# ── Anthropic ──
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Ollama ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# ── Offline (serves pre-generated corpus, no LLM needed) ──
CORPUS_DIR=./corpus

# ── Server ──
PORT=3000
